# DeepL API Anahtarı (Auth Key)
DEEPL_AUTH_KEY=your_api_key_here

# (Opsiyonel) 'é' tuşu için özel keycode tanımlaması (virgülle ayrılmış)
# Varsayılan: 10,50 (Mac Türkçe Q standart keycode 10 ve ISO section 50)
# 'python main.py --detect-key' ile tuşunuzun keycode'unu bulabilirsiniz.
E_KEYCODES=10,50
